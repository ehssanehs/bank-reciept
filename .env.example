# ------------------------------------------------------------------
#  Bank Payment Verification System — Environment Configuration
#  Copy to .env and fill in real values. NEVER commit real secrets.
# ------------------------------------------------------------------

APP_NAME="Bank Payment Verification"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database (MySQL/MariaDB in production, SQLite in tests) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bank_payment
DB_USERNAME=bank_payment
DB_PASSWORD=change_me_db_password

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CLIENT=phpredis

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# --- Laravel Session / Mail ---
SESSION_LIFETIME=120
MAIL_MAILER=log

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_MODE=longpolling        # longpolling | webhook
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook

# --- OCR ---
# OCR_PROVIDER=tesseract | cloud
OCR_PROVIDER=tesseract
OCR_API_KEY=
OCR_API_URL=
OCR_CONFIDENCE_THRESHOLD=0.75
OCR_MAX_ATTEMPTS=3

# --- Payment Matching ---
PAYMENT_MATCH_TIME_TOLERANCE=15     # minutes
AUTO_APPROVAL_ENABLED=true
ALLOWED_CURRENCIES=IRR,USD,EUR
AUTO_APPROVE_CONFIDENCE_THRESHOLD=0.75
MAX_RECEIPT_SIZE_MB=10
RECEIPT_ALLOWED_MIME=jpg,jpeg,png,webp,pdf
RECEIPT_RETENTION_DAYS=365

# --- Fraud / Risk ---
FRAUD_MAX_RECEIPTS_PER_PAYMENT=5
FRAUD_MAX_PAYMENTS_PER_CUSTOMER_DAY=20
FRAUD_MAX_TELEGRAM_PAYMENTS_DAY=20
FRAUD_RISK_AUTO_REVIEW_THRESHOLD=50
FRAUD_FUTURE_TOLERANCE_MINUTES=30
FRAUD_VERIFICATION_WINDOW_HOURS=72

# --- Android / Devices ---
ANDROID_API_KEY=
DEVICE_SIGNATURE_REPLAY_TTL=300
DEVICE_TOKEN_TTL=86400
ANDROID_DEFAULT_SENDER_PATTERNS=BANK,MCI,IRANCELL,SepahBank,Teb,Payam

# --- Uploads / Storage ---
RECEIPT_STORAGE_PATH=receipts
FILESYSTEM_DISK=local
SIGNED_URL_TTL_MINUTES=30

# --- Seeding / First admin ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
ADMIN_NAME="System Administrator"

# --- Misc ---
TELEGRAM_LINK_CODE_TTL_MINUTES=10
PERPAGE_DEFAULT=25
